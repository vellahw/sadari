APP_IMAGE=sadari-app:latest
APP_PORT=8080

DB_URL=jdbc:mysql://your-rds-endpoint.ap-northeast-2.rds.amazonaws.com:3306/sadari?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&useSSL=true&rewriteBatchedStatements=true
DB_USERNAME=sadari
DB_PASSWORD=change-me
DB_CONNECTION_TIMEOUT=60000
DB_MAXIMUM_POOL_SIZE=10
DB_MINIMUM_IDLE=2

HTTP_CONNECT_TIMEOUT_MILLIS=3000
HTTP_READ_TIMEOUT_MILLIS=5000

FRONT_DOMAIN=https://your-front-domain.com
BACK_DOMAIN=https://your-api-domain.com

JWT_SECRET=replace-with-long-random-base64-compatible-secret
JWT_ACCESS_TOKEN_SECONDS=1800
JWT_REFRESH_TOKEN_SECONDS=86400
JWT_REFRESH_ROTATION_GRACE_SECONDS=10
WITHDRAWAL_HARD_DELETE_WAIT_DAYS=30
TIMER_ATTENDANCE_MIN_SECONDS=600
TIMER_MAX_SESSION_SECONDS=28800
TIMER_ZONE_ID=Asia/Seoul
TIMER_DETAIL_RETENTION_DAYS=365

KAKAO_REST_API_KEY=change-me
KAKAO_JAVASCRIPT_KEY=change-me
KAKAO_NATIVE_APP_KEY=
GOOGLE_TRANSLATION_API_KEY=replace-with-translation-api-key
GOOGLE_BOOKS_API_KEY=replace-with-books-api-key
BOOK_SEARCH_CACHE_HIT_RATE_LIMIT_PER_MINUTE=300
BOOK_SEARCH_CACHE_MISS_RATE_LIMIT_PER_MINUTE=60
BOOK_SEARCH_RATE_LIMIT_PER_DAY=200
BOOK_SEARCH_PROVIDER_CALL_LIMIT_PER_DAY=27000
BOOK_SEARCH_CACHE_TTL_SECONDS=600
BOOK_SEARCH_POPULAR_KEYWORD_WINDOW_DAYS=7
BOOK_SEARCH_POPULAR_KEYWORD_MIN_USER_COUNT=3
BOOK_SEARCH_POPULAR_KEYWORD_MAX_SIZE=10

FIREBASE_WEB_API_KEY=change-me
FIREBASE_WEB_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_WEB_PROJECT_ID=your-project-id
FIREBASE_WEB_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_WEB_MESSAGING_SENDER_ID=change-me
FIREBASE_WEB_APP_ID=change-me
FIREBASE_VAPID_PUBLIC_KEY=change-me
FIREBASE_CREDENTIALS_PATH=file:/run/secrets/firebase-service-account.json

REDIS_PASSWORD=
REDIS_PORT=6379

MULTIPART_MAX_FILE_SIZE=20MB
MULTIPART_MAX_REQUEST_SIZE=40MB

STORAGE_PROVIDER=s3
STORAGE_LOCAL_ROOT=C:/shared/sadari-uploads
STORAGE_S3_BUCKET=your-private-bucket-name
STORAGE_S3_REGION=ap-northeast-2
STORAGE_S3_ENDPOINT=
STORAGE_S3_PATH_STYLE_ACCESS=false
AWS_ACCESS_KEY_ID=replace-with-iam-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-iam-secret-access-key

COOKIE_SECURE=true
COOKIE_SAME_SITE=None

SERVER_PORT=8080
LOGGING_LEVEL_ROOT=info
LOGGING_LEVEL_APP=info
