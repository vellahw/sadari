# loc 프로필 전용 Spring Properties 형식의 RDS 연결 예시
# rds.env로 복사 후 실제 값 입력, Git 커밋 금지
# 값에 따옴표 사용 금지, 비밀번호의 역슬래시는 두 번 입력
RDS_HOST=your-rds-endpoint.ap-northeast-2.rds.amazonaws.com
RDS_PORT=3306
DB_USERNAME=your-db-user
DB_PASSWORD=change-me
DB_URL=jdbc:mysql://${RDS_HOST}:${RDS_PORT}/sadari?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&sslMode=VERIFY_IDENTITY&trustCertificateKeyStoreUrl=file:///path/to/truststore.p12&trustCertificateKeyStoreType=PKCS12&trustCertificateKeyStorePassword=changeit&rewriteBatchedStatements=true
DB_CONNECTION_TIMEOUT=60000
DB_MAXIMUM_POOL_SIZE=5
DB_MINIMUM_IDLE=1
